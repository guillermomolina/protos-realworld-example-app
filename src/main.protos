//! Native HTTP entry point for the RealWorld learning application.
//!
//! Run with (the data directory must be initialized first: make init-data):
//!   protos --allow-network --allow-entropy --allow-clock \
//!     --allow-filesystem=<data-directory> --service=service src/main.protos
//!
//! The RootActor owns Network and Filesystem authority, the durable journal
//! and the single committed MemoryStore. Startup order: Clock/Entropy/JWT key
//! -> Filesystem -> journal lock -> journal File -> complete recovery ->
//! restored store + Auth -> Api -> listener -> Workers -> REALWORLD_HTTP_READY.
//! There is no fallback to an ephemeral store: any persistence failure stops
//! startup before the listener exists.
//! Two Worker Actors accept connections through explicitly delegated
//! TcpAcceptor capabilities. Workers request responses from the RootActor;
//! they cannot access its store or inherit its Network authority.
//!
//! Each Worker processes one HTTP connection at a time. This bounds the
//! application's active sessions to two, without introducing shared state.
//!
//! Suggested reading order for someone new to the project:
//!   main -> HttpWorker -> Api -> Auth -> AuthStore -> MemoryStore.
//! Follow Articles/Comments/Users last to see how domain values become JSON.
//!
//! One request travels through these steps:
//!   TCP connection -> Worker reads HTTP -> RootActor handles a data snapshot
//!   -> Router selects a handler -> authenticate/validate/change state
//!   -> build response Bytes -> Worker writes HTTP and closes the connection.
//!
//! Protos notation used throughout this example:
//!   name: value declares a binding or an object slot; name = value updates it.
//!   (arguments) => { ... } creates a Closure (a function). Its final expression
//!   is its result. { name: value } builds an object with named slots.
//!   import(...) loads a module; .slot reads a slot and .method(...) calls it.
//!   Keep `} else {` on the same logical line: a newline ends the conditional.
//!
//! An Actor owns its mutable state and communicates by messages. A capability
//! is an object granting a particular operation, such as accepting connections.
//! The CLI supplies Network, Entropy and Clock only with the explicit grants.
//! Passing a capability is a deliberate grant of authority, not just data sharing.
//! This module exports service; importing it does not itself start a listener.

IpAddress: import("std:network/ip_addresses").IpAddress
Level: import("std:logging/level")
Logger: import("std:logging/logger")
TextSink: import("std:logging/text_sink")
ColorMode: import("std:text/color_mode")
ColoredFormatter: import("std:logging/colored_formatter")
Store: import("./app/MemoryStore.protos")
Api: import("./app/Api.protos")
HttpWorkers: import("./app/HttpWorkers.protos")
Auth: import("./app/Auth.protos")
Journal: import("./app/persistence/Journal.protos")
JournalCodec: import("./app/persistence/JournalCodec.protos")
DurableStore: import("./app/persistence/DurableStore.protos")
Base64url: import("std:text/base64url")
Instant: import("std:datetime/instant")

/// Install the application service behavior on the RootActor.
/// The bootstrap schedules startup after READY, so listener acquisition
/// and Worker initialization run in an ordinary Actor message turn.
service: () => {
    // TextWriter turns Strings into output using the process's chosen encoding.
    // stdout is a capability too; only this Actor writes application logs.
    writer: TextWriter(
        process.stdout(),
        process.stdoutEncoding()
    )
    // All output authority stays with the RootActor. Workers send only data.
    log: Logger(Level.INFO, TextSink(
        ColoredFormatter(ColorMode.ALWAYS, false),
        writer
    )).with(
        %{ "component": "realworld" }
    )

    // The committed durable store exists only after successful recovery.
    store: null
    journal: null
    durable: null
    handler: null

    // A GroupRef grants request/reply communication with this service
    // without granting Workers permission to stop the RootActor.
    application: Actor.group(Actor.current())

    listener: null
    host: null

    // Emit only a fixed application label, never the provider's exception,
    // environment contents or key material. Startup must still fail closed.
    failStartup: (reason) => {
        writer.writeLine("REALWORLD_HTTP_STARTUP_FAILED=" + reason).value()
        Error().signal()
    }
    // A failed startup after the journal is open closes it, which releases
    // the cooperative lock (no write can be in flight before readiness).
    abandonJournal: () => {
        if(journal !== null) {
            Error.handle(
                () => { journal.close() },
                (failure) => {
                    writer.writeLine("REALWORLD_JOURNAL_FAILURE=close_after_startup_failure").value()
                    failure
                }
            )
            journal = null
        }
        true
    }
    startupStep: (name, operation) => {
        // Error.handle evaluates the first Closure and invokes the second if
        // an Error is signaled. Re-signaling keeps startup unsuccessful; the
        // safe label explains the stage without exposing the exception payload.
        result: null
        Error.handle(
            () => { result = operation() },
            (failure) => {
                writer.writeLine("REALWORLD_HTTP_STARTUP_FAILED=" + name).value()
                abandonJournal()
                failure.signal()
            }
        )
        result
    }
    // Journal diagnostics are fixed labels: never paths, payloads or errors.
    journalReport: (label) => {
        writer.writeLine("REALWORLD_JOURNAL_FAILURE=" + label).value()
        label
    }

    behavior: {
        // The returned object's slots are the messages this Actor can handle.
        // send("start") below schedules startup; it does not call start inline.
        start: () => {
            // Resolve explicit RootActor authorities before opening a listener.
            // This observation also fails startup if Clock is absent.
            startupStep("clock", () => { Instant(clock.epochNanoseconds()) })
            encodedKey: startupStep("environment", () => {
                process.environment().get("REALWORLD_JWT_KEY_BASE64URL")
            })
            if(encodedKey === null) { failStartup("missing_REALWORLD_JWT_KEY_BASE64URL") }
            key: startupStep("jwt_key_base64url_decode", () => {
                Base64url.decode(encodedKey)
            })
            if(key === null) { failStartup("invalid_jwt_key") }
            if((key.size() < 32) || (key.size() > 4096)) {
                failStartup("jwt_key_requires_32_to_4096_octets")
            }
            // Resolve Entropy before readiness rather than waiting for the
            // first registration. These bytes are not a replacement key.
            entropyProbe: startupStep("entropy", () => { entropy.bytes(16).value() })
            if(entropyProbe.size() != 16) { failStartup("invalid_entropy_result") }
            // Explicit Filesystem grant (--allow-filesystem=<dir>). Absence is
            // fatal: the durable service never runs without its journal.
            granted: startupStep("filesystem", () => { filesystem })
            if(granted === null) { failStartup("missing_filesystem_authority") }
            // An incomplete final frame is never removed implicitly. The
            // operator may authorize this single repair for one start.
            repairTail: false
            startupStep("journal_repair_setting", () => {
                setting: process.environment().get("REALWORLD_JOURNAL_REPAIR")
                repairTail = (setting !== null) && (setting == "truncate-incomplete-tail")
            })
            limits: JournalCodec.defaultLimits()
            journalLimits: {
                maxPayloadBytes: limits.maxPayloadBytes
                maxJournalBytes: limits.maxJournalBytes
                maxFrames: limits.maxFrames
                repairIncompleteTail: repairTail
            }
            journal = startupStep("journal_open", () => {
                Journal.open(granted, Journal.journalPath(), Journal.lockPath(),
                    journalLimits, journalReport)
            })
            recovered: startupStep("journal_recovery", () => { journal.recover() })
            // Separates this process's transaction IDs from earlier runs'.
            nonce: startupStep("transaction_nonce", () => { entropy.bytes(8).value() })
            durable = startupStep("durable_store", () => {
                DurableStore.create(journal, recovered, nonce, DurableStore.defaultOptions())
            })
            store = durable.store
            log.info("journal recovered", %{
                "frames": recovered.frames
                "applied": recovered.applied
            })
            // Never captured by a Worker or included in request/reply data.
            // now is a zero-argument Closure, not a cached startup timestamp.
            // Auth invokes it whenever it needs the current trusted time.
            handler = startupStep("authentication_setup", () => {
                authentication: Auth.create(store, entropy, key,
                    () => { Instant(clock.epochNanoseconds()) })
                Api.make(store, authentication)
            })

            listener = startupStep("listen_127_0_0_1_3000", () => {
                network.listenTcp(
                    ipVersion: 4,
                    address: IpAddress(4, 2130706433),
                    port: 3000
                ).value()
            })

            // Keep Worker startup, service replies and lifetime ownership
            // together, so drain can wait for admitted sessions to retire.
            host = startupStep("http_workers", () => {
                HttpWorkers.start(listener, application, 2)
            })

            // Announce readiness only after the listener exists and both
            // Worker behaviors are initialized and scheduled to serve.
            log.info("http listener ready", %{
                "address": "127.0.0.1"
                "port": 3000
                "workers": 2
            })
            // Kept as a simple, stable readiness marker for CLI consumers.
            writer.writeLine(
                "REALWORLD_HTTP_READY=127.0.0.1:3000"
            ).value()

            // A local console command requests explicit graceful drain. EOF
            // leaves the server running, as for an unattended service.
            // Ctrl-C remains a host termination, not this drain protocol.
            (() => {
                Error.handle(
                    () => {
                        stdin: TextReader(process.stdin(), process.stdinEncoding())
                        command: stdin.readLine().value()
                        while((command !== null) && (command != "quit")) {
                            command = stdin.readLine().value()
                        }
                        if(command !== null) {
                            Actor.current().send("shutdown", "drain")
                        }
                    },
                    (error) => {
                        log.warn("console control unavailable")
                        error
                    }
                )
                null
            }).future()
            null
        }

        // Workers transfer the request's method, raw target, version,
        // ordered headers and bounded body Bytes. Connections and live
        // ByteReadable request streams never leave their Worker Actor.
        connectionAccepted: (workerId) => {
            log.info("tcp connection accepted", %{ "worker": workerId })
            null
        }
        connectionFailed: (workerId) => {
            log.error("http session failed", %{ "worker": workerId })
            null
        }
        handle: (request) => {
            // This is where the Workers' request messages enter application code.
            // handler returns ordinary response data; it never writes a socket.
            response: handler(request)
            // This records the generated response, not a completed TCP write.
            // Deliberately omit target/query, headers and body to avoid
            // logging credentials or other request content.
            log.info("http response prepared", %{
                "method": request.method
                "status": response.status
            })
            response
        }
        // This behavior is not exposed through an HTTP management route.
        // The RootActor alone retains listener close and ActorRef.stop authority.
        shutdown: (mode) => {
            log.info("http shutdown requested", %{ "mode": mode })
            host.shutdown(mode).value()
            log.info("http shutdown complete", %{ "mode": mode })
            // Workers are retired: no request can be admitted any more. Settle
            // the in-progress transaction (if any), close the journal and
            // release the lock only when that is safe.
            Error.handle(
                () => {
                    durable.close()
                    log.info("journal closed")
                },
                (failure) => {
                    log.error("journal close incomplete; lock retained")
                    failure
                }
            )
            Actor.current().stop()
            null
        }

    }

    Actor.current().send("start")
    behavior
}
