//! HTTP connection Worker for the native RealWorld application.
//!
//! This Actor receives an attenuated TcpAcceptor and a GroupRef to the
//! application service. Neither Network nor MemoryStore is transferred.
//!
//! HTTP parsing and connection custody stay here; business logic and
//! mutable application state remain in the RootActor. Drain never cancels
//! a session that was admitted before the shutdown cutover.
//!
//! Think of this Actor as one independent HTTP connection attendant. The
//! acceptor lets it accept from an existing listener but not open new listeners.
//! application is a communication reference: request("handle", data) asks the
//! RootActor for a reply, whereas send(...) reports an event without waiting.
//!
//! Network calls return Futures. .value() suspends this turn while waiting for
//! acceptance, body data or an application reply; it is not a polling loop.
//! The Actor can then process drain/abort messages while its service is waiting.
//! There is one active session per Worker, and two Workers in the main service.

Server: import("std:http/server").Server

/// Build the Worker behavior from explicitly delegated capabilities.
/// This is a SOURCE bootstrap binding selected by Actor.spawn.
start: (acceptor, application, workerId) => {
    admitting: true
    serving: false
    pending: null
    active: null
    failureKind: null

    // Std HTTP caps decoded request content at 1 MiB, including chunked
    // messages. An oversized Content-Length is rejected before the handler;
    // a late framing/limit failure remains owned by std:http/server.
    httpLimits: { maxRequestBodyBytes: 1048576 }

    handleRequest: (request) => {
        // request.body is a session-scoped ByteReadable and cannot be sent
        // to another Actor. Consume it while the Worker still owns the HTTP
        // session, then transfer only ordinary data and Bytes snapshots.
        content: Encoding.Latin1.encode("")
        chunk: request.body.read(8192).value()
        while(chunk !== null) {
            for(octet in chunk) {
                content.add(octet)
            }
            chunk = request.body.read(8192).value()
        }

        application.request("handle", {
            // Headers stay ordered pairs, preserving duplicates for security
            // checks. The target stays raw Bytes so Router owns URL decoding.
            method: request.method
            target: request.target
            version: request.version
            headers: request.headers
            body: content
        }).value()
    }

    behavior: {
        /// The long-running service replies only after admission ends and its
        /// one in-flight session has retired with owning cleanup.
        serve: () => {
            serving = true
            while(admitting) {
                connection: null
                acceptFailure: null
                pending = acceptor.accept()
                Error.handle(
                    () => { connection = pending.value() },
                    (error) => {
                        acceptFailure = error
                        error
                    }
                )
                pending = null

                if(acceptFailure !== null) {
                    admitting = false
                    if((acceptFailure.parent() !== IOLifecycleError) &&
                       (acceptFailure.parent() !== Cancelled)) {
                        failureKind = "listener"
                        application.send("connectionFailed", workerId)
                    }
                } else {
                    if(admitting) {
                        application.send("connectionAccepted", workerId)
                        // The server owns the accepted connection and closes it
                        // on success, failure or cancellation.
                        Error.handle(
                            () => {
                                active = Server.serveOne.owning(
                                    // "owning" gives the server responsibility
                                    // for closing this one connection on every
                                    // completion path, including cancellation.
                                    connection,
                                    handleRequest,
                                    httpLimits
                                )
                                active.value()
                            },
                            (error) => {
                                application.send("connectionFailed", workerId)
                                error
                            }
                        )
                        active = null
                    } else {
                        // A delivery racing the admission cutover is not served.
                        Error.handle(
                            () => { connection.close().value() },
                            (error) => {
                                failureKind = "cleanup"
                                application.send("connectionFailed", workerId)
                                error
                            }
                        )
                    }
                }
            }
            result: "drained"
            if(failureKind !== null) {
                result = failureKind
            }
            result
        }

        /// Same-sender FIFO places this request after serve entered its first
        /// suspended accept operation, not merely after Actor initialization.
        ready: () => {
            serving && admitting
        }

        /// Stop new admission. The RootActor closes the listener to wake a
        /// pending accept. An in-flight HTTP session finishes normally.
        drain: () => {
            admitting = false
            null
        }

        /// Cancel pending acceptance and the active session, whose owning
        /// cleanup still runs before serve replies.
        abort: () => {
            admitting = false
            if(pending !== null) {
                pending.cancel()
            }
            if(active !== null) {
                active.cancel()
            }
            null
        }
    }

    behavior
}
