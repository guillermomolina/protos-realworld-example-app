//! Actor-local RealWorld favorite edges keyed by stable identity IDs.
//!
//! Trusted domain operations: the supplied user ID is not an HTTP principal.
//! The caller provides identity lookup and article existence; no credentials,
//! networking, or authorization are supplied by this module.
//!
//! Edges are unique per identity/article. Counts remain owned by MemoryStore,
//! which adjusts them only when a new edge is inserted or removed.
//!
//! An edge is {actorId, slug}. It says that one account favorited one article.
//! The historical Fixture method names remain for earlier tests; authenticated
//! HTTP handlers use MemoryStore's favorite/unfavorite wrappers over this graph.
//! ok=true/changed=false is a successful repeat, not a failure. Keeping those
//! flags separate prevents repeated requests from inflating favoritesCount.

Arrays: import("std:collections/array")

accepted: (changed) => {
    {
        ok: true
        changed: changed
        field: null
        message: null
    }
}

rejected: (field, message) => {
    {
        ok: false
        changed: false
        field: field
        message: message
    }
}

edgeCopy: (edge) => {
    {
        actorId: edge.actorId
        slug: edge.slug
    }
}

/// Validate restored edges: existing account and article, unique pairs.
/// Favorite counts are cross-checked against ContentStore by MemoryStore.
validEdges: (identities, articleExists, initialEdges) => {
    seen: []
    for(edge in initialEdges) {
        if(identities.findId(edge.actorId) === null) { Error().signal() }
        if(!articleExists(edge.slug)) { Error().signal() }
        for(other in seen) {
            if((other.actorId == edge.actorId) && (other.slug == edge.slug)) { Error().signal() }
        }
        seen = Arrays.append(seen, edge)
    }
    true
}

restore: (identities, articleExists, initialEdges) => {
    validEdges(identities, articleExists, initialEdges)
    build(identities, articleExists, initialEdges)
}

create: (identities, articleExists) => { build(identities, articleExists, []) }

build: (identities, articleExists, initialEdges) => {
    edges: Arrays.map(initialEdges, edgeCopy)

    contains: (actorId, slug) => {
        found: false
        for(edge in edges) {
            if((edge.actorId == actorId) && (edge.slug == slug)) {
                found = true
            }
        }
        found
    }

    store: {
        /// Durable export: fresh edges in insertion order.
        exportState: () => { Arrays.map(edges, edgeCopy) }

        isFavorited: (actorId, slug) => {
            contains(actorId, slug)
        }

        // Return an independent Array. The caller cannot mutate retained edges.
        slugsFor: (actorId) => {
            slugs: []
            for(edge in edges) {
                if(edge.actorId == actorId) {
                    slugs = Arrays.append(slugs, edge.slug)
                }
            }
            slugs
        }

        favoriteFixture: (actorId, slug) => {
            outcome: null
            if(identities.findId(actorId) === null) {
                outcome = rejected("user", "not found")
            } else {
                if(!articleExists(slug)) {
                    outcome = rejected("article", "not found")
                } else {
                    if(contains(actorId, slug)) {
                        outcome = accepted(false)
                    } else {
                        edges = Arrays.append(edges, {
                            actorId: actorId
                            slug: slug
                        })
                        outcome = accepted(true)
                    }
                }
            }
            outcome
        }

        unfavoriteFixture: (actorId, slug) => {
            outcome: null
            if(identities.findId(actorId) === null) {
                outcome = rejected("user", "not found")
            } else {
                if(!articleExists(slug)) {
                    outcome = rejected("article", "not found")
                } else {
                    if(contains(actorId, slug)) {
                        edges = Arrays.filter(edges, (edge) => {
                            !((edge.actorId == actorId) && (edge.slug == slug))
                        })
                        outcome = accepted(true)
                    } else {
                        outcome = accepted(false)
                    }
                }
            }
            outcome
        }

        // The owning article is already deleted by this point. No count
        // adjustment is needed; the article and its counter no longer exist.
        removeArticleFixture: (slug) => {
            edges = Arrays.filter(edges, (edge) => {
                edge.slug != slug
            })
            true
        }
    }

    store
}
