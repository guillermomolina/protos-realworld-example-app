//! JSON presentation of RealWorld articles, profiles and tags.
//!
//! Domain objects are ordinary Protos values. This module converts them
//! into std:json nodes without changing the underlying data.
//! HTTP status codes and storage concerns are handled elsewhere.
//!
//! The older entry points profile/article/list/single produce anonymous views.
//! Their *For variants accept viewerId/store to project follows and favorites.
//! They only read relationships; they neither authenticate nor change them.

JSON: import("std:json/json")
Arrays: import("std:collections/array")

/// Represent an optional String as a JSON string or JSON null.
/// A Protos null value must not be serialized as the text "null".
nullableText: (value) => {
    answer: JSON.nullValue()
    if(value !== null) {
        answer = JSON.string(value)
    }
    answer
}

/// Build the public profile representation.
/// Without an authenticated viewer, following is always false.
profile: (author) => { profileFor(author, null, null) }

/// Resolve following through the current username's stable identity ID. null
/// viewerId means anonymous and permits store=null in compatibility helpers.
profileFor: (author, viewerId, store) => {
    following: false
    if(viewerId !== null) {
        target: store.identityByUsername(author.username)
        if(target !== null) { following = store.isFollowingIdentity(viewerId, target.id) }
    }
    JSON.object(
        "username", JSON.string(author.username),
        "bio", nullableText(author.bio),
        "image", nullableText(author.image),
        "following", JSON.boolean(following)
    )
}

/// Build an article representation.
/// Lists omit the body; detail responses include it.
/// Public requests have no viewer identity, so favorited is false.
article: (value, detailed) => { articleFor(value, detailed, null, null) }

/// detailed=false omits body for list entries; detailed=true includes it.
/// favoritesCount is the total for everyone; favorited is specific to the viewer.
articleFor: (value, detailed, viewerId, store) => {
    favorited: false
    if(viewerId !== null) { favorited = store.isFavoritedByIdentity(viewerId, value.slug) }
    tags: []
    for(tag in value.tagList) {
        tags = Arrays.append(tags, JSON.string(tag))
    }

    fields: [
        "slug", JSON.string(value.slug),
        "title", JSON.string(value.title),
        "description", JSON.string(value.description),
        "tagList", JSON.array(...tags),
        "createdAt", JSON.string(value.createdAt),
        "updatedAt", JSON.string(value.updatedAt),
        "favorited", JSON.boolean(favorited),
        "favoritesCount", JSON.number(value.favoritesCount, 0),
        "author", profileFor(value.author, viewerId, store)
    ]

    if(detailed) {
        fields = Arrays.append(fields, "body")
        fields = Arrays.append(fields, JSON.string(value.body))
    }

    JSON.object(...fields)
}

/// Build the article-list envelope.
/// total is the number of matching articles before pagination,
/// not the number of articles included in this page.
list: (values, total) => { listFor(values, total, null, null) }

listFor: (values, total, viewerId, store) => {
    nodes: []
    for(value in values) {
        nodes = Arrays.append(nodes, articleFor(value, false, viewerId, store))
    }

    JSON.object(
        "articles", JSON.array(...nodes),
        "articlesCount", JSON.number(total, 0)
    )
}

tags: (values) => {
    nodes: []
    for(value in values) {
        nodes = Arrays.append(nodes, JSON.string(value))
    }
    JSON.object("tags", JSON.array(...nodes))
}

single: (value) => {
    JSON.object("article", article(value, true))
}

singleFor: (value, viewerId, store) => {
    JSON.object("article", articleFor(value, true, viewerId, store))
}
