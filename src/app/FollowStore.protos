//! Actor-local follow graph keyed by stable identity IDs.
//!
//! A relationship is an ordered pair of existing identity IDs. Changes are
//! idempotent and never expose an authentication capability. MemoryStore uses
//! the trusted Fixture operations after Api obtains a principal from Auth.
//!
//! An edge is {followerId, followedId}: its direction matters. Following someone
//! includes that author's articles in your feed; it does not make them follow
//! you. The graph checks both identities exist and disallows self-follow.
//! Repeating follow/unfollow succeeds without inserting/removing a second edge.
//! Results use ok for success and changed for whether an edge actually changed.

Arrays: import("std:collections/array")

accepted: (changed) => {
    {
        ok: true
        changed: changed
        field: null
        message: null
    }
}

rejected: (field, message) => {
    {
        ok: false
        changed: false
        field: field
        message: message
    }
}

edgeCopy: (edge) => {
    {
        followerId: edge.followerId
        followedId: edge.followedId
    }
}

/// Validate restored edges: both identities exist, no self-follow, unique.
/// Edges are restored only from stable IDs, never rebuilt from usernames.
validEdges: (identities, initialEdges) => {
    seen: []
    for(edge in initialEdges) {
        if(identities.findId(edge.followerId) === null) { Error().signal() }
        if(identities.findId(edge.followedId) === null) { Error().signal() }
        if(edge.followerId == edge.followedId) { Error().signal() }
        for(other in seen) {
            if((other.followerId == edge.followerId) && (other.followedId == edge.followedId)) {
                Error().signal()
            }
        }
        seen = Arrays.append(seen, edge)
    }
    true
}

restore: (identities, initialEdges) => {
    validEdges(identities, initialEdges)
    build(identities, initialEdges)
}

/// Each instance is independent and receives its identity lookup explicitly.
create: (identities) => { build(identities, []) }

build: (identities, initialEdges) => {
    edges: Arrays.map(initialEdges, edgeCopy)

    contains: (followerId, followedId) => {
        found: false
        for(edge in edges) {
            if((edge.followerId == followerId) &&
               (edge.followedId == followedId)) {
                found = true
            }
        }
        found
    }

    graph: {
        /// Durable export: fresh directed edges in insertion order.
        exportState: () => { Arrays.map(edges, edgeCopy) }

        isFollowing: (followerId, followedId) => {
            contains(followerId, followedId)
        }

        /// Return a new Array of followed IDs; no mutable edge escapes.
        followingIdsFor: (followerId) => {
            result: []
            for(edge in edges) {
                if(edge.followerId == followerId) {
                    result = Arrays.append(result, edge.followedId)
                }
            }
            result
        }

        /// Return a new Array of follower IDs; no mutable edge escapes.
        followerIdsFor: (followedId) => {
            result: []
            for(edge in edges) {
                if(edge.followedId == followedId) {
                    result = Arrays.append(result, edge.followerId)
                }
            }
            result
        }

        /// Trusted edge mutation shared by fixtures and the application facade.
        /// Supplying numeric IDs alone is never HTTP authorization.
        followFixture: (followerId, followedId) => {
            result: null
            if(identities.findId(followerId) === null) {
                result = rejected("follower", "not found")
            } else {
                if(identities.findId(followedId) === null) {
                    result = rejected("profile", "not found")
                } else {
                    if(followerId == followedId) {
                        result = rejected("profile", "cannot follow yourself")
                    } else {
                        if(contains(followerId, followedId)) {
                            result = accepted(false)
                        } else {
                            edges = Arrays.append(edges, {
                                followerId: followerId
                                followedId: followedId
                            })
                            result = accepted(true)
                        }
                    }
                }
            }
            result
        }

        /// Removing an absent valid relationship is an idempotent success.
        unfollowFixture: (followerId, followedId) => {
            result: null
            if(identities.findId(followerId) === null) {
                result = rejected("follower", "not found")
            } else {
                if(identities.findId(followedId) === null) {
                    result = rejected("profile", "not found")
                } else {
                    if(contains(followerId, followedId)) {
                        edges = Arrays.filter(edges, (edge) => {
                            !((edge.followerId == followerId) &&
                              (edge.followedId == followedId))
                        })
                        result = accepted(true)
                    } else {
                        result = accepted(false)
                    }
                }
            }
            result
        }
    }

    graph
}
