//! Actor-local, credential-free RealWorld identity record repository.
//!
//! Stable numeric IDs, exact username/email uniqueness, atomic replacement,
//! and immutable-by-copy lookup results. Contains no password, verifier, token,
//! signing key, login method or cryptographic substitute.
//!
//! MemoryStore reuses the trusted Fixture operations for authenticated account
//! admission/update after AuthStore performs security work. The operations here
//! cannot authenticate a client or issue a token by themselves.
//!
//! A numeric id is assigned once; usernames/emails can change. Other stores keep
//! that id as their owner/relationship key, so a rename preserves ownership.
//! Lookups return new objects: editing a returned profile cannot edit retained
//! state. Rejected insertions do not advance nextId or occupy either name.
//!
//! restore/exportState support durable recovery: restoration validates the
//! complete record set and nextId, then constructs the store directly.

Arrays: import("std:collections/array")

/// Never give callers an alias of an internally retained mutable record.
snapshot: (record) => {
    {
        id: record.id
        username: record.username
        email: record.email
        bio: record.bio
        image: record.image
    }
}

publicProfile: (record) => {
    {
        username: record.username
        bio: record.bio
        image: record.image
    }
}

accepted: (record) => {
    {
        ok: true
        value: snapshot(record)
        field: null
        message: null
    }
}

rejected: (field, message) => {
    {
        ok: false
        value: null
        field: field
        message: message
    }
}

/// RealWorld nullable profile fields: an empty String is stored as null.
nullable: (value) => {
    answer: value
    if(value == "") {
        answer = null
    }
    answer
}

/// Durable restoration: validate a complete record set, then construct the
/// store in one step. Never replays registration logic, never reassigns an ID.
/// Signals an Error for duplicate IDs/usernames/emails, blank names, "" in a
/// nullable field (it would have been normalized to null) or a nextId that
/// does not exceed every retained ID (which would permit accidental reuse).
validRecords: (initialRecords, initialNextId) => {
    if(initialNextId < 1) { Error().signal() }
    seenIds: []
    seenUsernames: []
    seenEmails: []
    for(record in initialRecords) {
        if((record.id < 1) || (record.id >= initialNextId)) { Error().signal() }
        if((record.username === null) || (record.username == "")) { Error().signal() }
        if((record.email === null) || (record.email == "")) { Error().signal() }
        if(record.bio == "") { Error().signal() }
        if(record.image == "") { Error().signal() }
        if(Arrays.contains(seenIds, record.id)) { Error().signal() }
        if(Arrays.contains(seenUsernames, record.username)) { Error().signal() }
        if(Arrays.contains(seenEmails, record.email)) { Error().signal() }
        seenIds = Arrays.append(seenIds, record.id)
        seenUsernames = Arrays.append(seenUsernames, record.username)
        seenEmails = Arrays.append(seenEmails, record.email)
    }
    true
}

restore: (initialRecords, initialNextId) => {
    validRecords(initialRecords, initialNextId)
    build(initialRecords, initialNextId)
}

/// Each invocation creates a completely independent in-memory identity store.
create: () => { build([], 1) }

/// Private constructor. Inputs are copied, so later edits by the caller cannot
/// reach retained records. Callers must have validated the inputs.
build: (initialRecords, initialNextId) => {
    records: Arrays.map(initialRecords, snapshot)
    nextId: initialNextId

    byId: (id) => {
        found: null
        for(record in records) {
            if(record.id == id) {
                found = record
            }
        }
        found
    }

    byUsername: (username) => {
        found: null
        for(record in records) {
            if(record.username == username) {
                found = record
            }
        }
        found
    }

    byEmail: (email) => {
        found: null
        for(record in records) {
            if(record.email == email) {
                found = record
            }
        }
        found
    }

    copyOrNull: (record) => {
        result: null
        if(record !== null) {
            result = snapshot(record)
        }
        result
    }

    // These lookups are intended for the RootActor application store only.
    // A public HTTP profile must use profileFor, not an account snapshot.
    store: {
        /// Durable export for the RootActor transaction coordinator only.
        /// Records are fresh copies in stable insertion (ID) order.
        exportState: () => {
            {
                records: Arrays.map(records, snapshot)
                nextId: nextId
            }
        }

        findId: (id) => {
            copyOrNull(byId(id))
        }

        findUsername: (username) => {
            copyOrNull(byUsername(username))
        }

        findEmail: (email) => {
            copyOrNull(byEmail(email))
        }

        profileFor: (username) => {
            record: byUsername(username)
            result: null
            if(record !== null) {
                result = publicProfile(record)
            }
            result
        }

        /// Trusted fixture insertion, never a registration endpoint.
        /// Uniqueness is exact/case-sensitive. HTTP email/password policy is
        /// enforced by RequestJson/AuthStore before reaching this repository.
        addFixture: (username, email, bio, image) => {
            outcome: null
            if((username === null) || (username == "")) {
                outcome = rejected("username", "can't be blank")
            } else {
                if((email === null) || (email == "")) {
                    outcome = rejected("email", "can't be blank")
                } else {
                    if(byUsername(username) !== null) {
                        outcome = rejected("username", "has already been taken")
                    } else {
                        if(byEmail(email) !== null) {
                            outcome = rejected("email", "has already been taken")
                        } else {
                            record: {
                                id: nextId
                                username: username
                                email: email
                                bio: nullable(bio)
                                image: nullable(image)
                            }
                            records = Arrays.append(records, record)
                            nextId = nextId + 1
                            outcome = accepted(record)
                        }
                    }
                }
            }
            outcome
        }

        /// Replace one fixture record in one commit. Rejection changes no
        /// record, field, nextId, or uniqueness index.
        updateFixture: (id, username, email, bio, image) => {
            existing: byId(id)
            outcome: rejected("user", "not found")
            if(existing !== null) {
                if((username === null) || (username == "")) {
                    outcome = rejected("username", "can't be blank")
                } else {
                    if((email === null) || (email == "")) {
                        outcome = rejected("email", "can't be blank")
                    } else {
                        usernameOwner: byUsername(username)
                        emailOwner: byEmail(email)
                        if((usernameOwner !== null) && (usernameOwner.id != id)) {
                            outcome = rejected("username", "has already been taken")
                        } else {
                            if((emailOwner !== null) && (emailOwner.id != id)) {
                                outcome = rejected("email", "has already been taken")
                            } else {
                                replacement: {
                                    id: id
                                    username: username
                                    email: email
                                    bio: nullable(bio)
                                    image: nullable(image)
                                }
                                nextRecords: []
                                for(record in records) {
                                    if(record.id == id) {
                                        nextRecords = Arrays.append(nextRecords, replacement)
                                    } else {
                                        nextRecords = Arrays.append(nextRecords, record)
                                    }
                                }
                                records = nextRecords
                                outcome = accepted(replacement)
                            }
                        }
                    }
                }
            }
            outcome
        }
    }

    store
}
