//! Minimal Actor-local data store for the learning application.
//!
//! State is captured by closures created inside create(). Each store
//! instance owns its own article, profile, comment and favorite collections.
//! There is no database, persistence or authentication authority.
//! An isolated identity repository holds only non-secret account metadata.
//! A separate follow graph and article-author bindings use stable IDs.
//!
//! Fixture insertion methods support examples and tests. They are not
//! replacements for authenticated RealWorld mutation endpoints.

Arrays: import("std:collections/array")
Identities: import("./IdentityStore.protos")
Follows: import("./FollowStore.protos")
ArticleQuery: import("./ArticleQuery.protos")
Content: import("./ContentStore.protos")
Favorites: import("./FavoriteStore.protos")

/// Create an independent in-memory store.
create: () => {
    items: []
    profiles: []
    comments: []
    favorites: []
    identities: Identities.create()
    follows: Follows.create(identities)
    content: Content.create(identities)
    // Fixture article objects are linked to their author IDs when
    // identities exist. Links survive later username changes.
    articleAuthors: []

    articleExists: (slug) => {
        found: content.has(slug)
        if(!found) {
            for(item in items) {
                if(item.slug == slug) {
                    found = true
                }
            }
        }
        found
    }

    favoritesById: Favorites.create(identities, articleExists)

    // Only a new/deleted favorite edge changes the stored counter.
    // For managed content, copies returned by ContentStore are never mutated.
    changeFavoriteCount: (slug, delta) => {
        if(content.has(slug)) {
            if(delta > 0) {
                content.incrementFavoriteFixture(slug)
            } else {
                content.decrementFavoriteFixture(slug)
            }
        } else {
            for(article in items) {
                if(article.slug == slug) {
                    article.favoritesCount = article.favoritesCount + delta
                }
            }
        }
        true
    }

    // Convert a previously unknown username's favorite fixtures to stable
    // identity IDs without incrementing the counts a second time.
    migrateLegacyFavorites: (actorId, username) => {
        remaining: []
        for(entry in favorites) {
            if(entry.username == username) {
                migrated: favoritesById.favoriteFixture(actorId, entry.slug)
                if(migrated.ok) {
                    if(!migrated.changed) {
                        // Both representations counted the same user/article.
                        changeFavoriteCount(entry.slug, -1)
                    }
                } else {
                    remaining = Arrays.append(remaining, entry)
                }
            } else {
                remaining = Arrays.append(remaining, entry)
            }
        }
        favorites = remaining
        true
    }

    store: {
        // A public profile may be registered explicitly, appear as
        // an article author, or appear only as a comment author.
        findProfile: (username) => {
            // Real identity metadata takes precedence over legacy
            // author/profile fixtures when the usernames coincide.
            found: identities.profileFor(username)

            if(found === null) {
                for(profile in profiles) {
                    if(profile.username == username) {
                        found = profile
                    }
                }
            }

            if(found === null) {
                for(article in items) {
                    if(article.author.username == username) {
                        found = article.author
                    }
                }
            }

            if(found === null) {
                for(entry in comments) {
                    if(entry.comment.author.username == username) {
                        found = entry.comment.author
                    }
                }
            }

            found
        }

        // Credential-free identity metadata. Only trusted fixture calls may
        // mutate this store; HTTP registration/login still return 422/501.
        identityById: (id) => {
            identities.findId(id)
        }

        identityByEmail: (email) => {
            identities.findEmail(email)
        }

        addIdentityFixture: (username, email, bio, image) => {
            result: identities.addFixture(username, email, bio, image)
            if(result.ok) {
                migrateLegacyFavorites(result.value.id, username)
            }
            result
        }

        updateIdentityFixture: (id, username, email, bio, image) => {
            previous: identities.findId(id)
            result: identities.updateFixture(id, username, email, bio, image)
            if(result.ok) {
                migrateLegacyFavorites(id, previous.username)
                if(username != previous.username) {
                    migrateLegacyFavorites(id, username)
                }
            }
            result
        }

        // Fixture-only social operations: they do not authenticate a caller.
        followIdentityFixture: (followerId, followedId) => {
            follows.followFixture(followerId, followedId)
        }

        unfollowIdentityFixture: (followerId, followedId) => {
            follows.unfollowFixture(followerId, followedId)
        }

        isFollowingIdentity: (followerId, followedId) => {
            follows.isFollowing(followerId, followedId)
        }

        followingIdentityIdsFor: (followerId) => {
            follows.followingIdsFor(followerId)
        }

        followerIdentityIdsFor: (followedId) => {
            follows.followerIdsFor(followedId)
        }

        /// Select followed authors' articles, newest first, then paginate.
        /// The viewer identity must exist. Options come from ArticleQuery.read.
        /// No caller may obtain this by sending an unauthenticated HTTP request.
        feedForIdentity: (viewerId, options) => {
            result: {
                ok: false
                page: []
                total: 0
                field: "user"
                message: "not found"
            }

            if(identities.findId(viewerId) !== null) {
                followedIds: follows.followingIdsFor(viewerId)
                selectedArticles: []
                for(article in items) {
                    authorId: null

                    // Prefer the stable association captured on insertion.
                    for(binding in articleAuthors) {
                        if(binding.article === article) {
                            authorId = binding.authorId
                        }
                    }

                    // Legacy fixtures may predate their author identity.
                    if(authorId === null) {
                        author: identities.findUsername(article.author.username)
                        if(author !== null) {
                            authorId = author.id
                        }
                    }

                    if((authorId !== null) &&
                       Arrays.contains(followedIds, authorId)) {
                        selectedArticles = Arrays.append(selectedArticles, article)
                    }
                }

                // Managed article authors are already linked by stable ID.
                for(entry in content.entries()) {
                    if(Arrays.contains(followedIds, entry.authorId)) {
                        selectedArticles = Arrays.append(
                            selectedArticles, entry.article
                        )
                    }
                }

                selected: ArticleQuery.select(selectedArticles, options, [])
                result = {
                    ok: true
                    page: selected.page
                    total: selected.total
                    field: null
                    message: null
                }
            }

            result
        }

        addProfileFixture: (profile) => {
            profiles = Arrays.append(profiles, profile)
            profile
        }

        commentsFor: (slug) => {
            result: []

            for(entry in comments) {
                if(entry.slug == slug) {
                    result = Arrays.append(result, entry.comment)
                }
            }
            for(comment in content.commentsFor(slug)) {
                result = Arrays.append(result, comment)
            }
            result
        }

        addCommentFixture: (slug, value) => {
            comments = Arrays.append(
                comments,
                {
                    slug: slug
                    comment: value
                }
            )
            value
        }

        // Stable-ID favorite operations are internal trusted fixtures.
        // These IDs cannot be supplied by an unauthenticated HTTP request.
        favoriteIdentityFixture: (actorId, slug) => {
            result: favoritesById.favoriteFixture(actorId, slug)
            if(result.ok && result.changed) {
                changeFavoriteCount(slug, 1)
            }
            result
        }

        unfavoriteIdentityFixture: (actorId, slug) => {
            result: favoritesById.unfavoriteFixture(actorId, slug)
            if(result.ok && result.changed) {
                changeFavoriteCount(slug, -1)
            }
            result
        }

        isFavoritedByIdentity: (actorId, slug) => {
            favoritesById.isFavorited(actorId, slug)
        }

        favoriteSlugsForIdentity: (actorId) => {
            favoritesById.slugsFor(actorId)
        }

        // Public ?favorited=username resolves the current identity, so
        // changing a username does not break its favorite edges.
        favoriteSlugsFor: (username) => {
            slugs: []
            actor: identities.findUsername(username)
            if(actor !== null) {
                slugs = favoritesById.slugsFor(actor.id)
            }
            // Keep pre-identity legacy fixtures working, without duplicates.
            for(entry in favorites) {
                if((entry.username == username) &&
                   !Arrays.contains(slugs, entry.slug)) {
                    slugs = Arrays.append(slugs, entry.slug)
                }
            }
            slugs
        }

        // Legacy fixture API remains available. Known identities are routed
        // through the stable-ID graph; unknown usernames remain string edges.
        addFavoriteFixture: (username, slug) => {
            article: store.find(slug)
            if(article === null) {
                Error().signal()
            }

            actor: identities.findUsername(username)
            if(actor !== null) {
                store.favoriteIdentityFixture(actor.id, slug)
            } else {
                present: Arrays.contains(store.favoriteSlugsFor(username), slug)
                if(!present) {
                    favorites = Arrays.append(favorites, {
                        username: username
                        slug: slug
                    })
                    changeFavoriteCount(slug, 1)
                }
            }
            store.find(slug)
        }

        // Return a new Array so query operations do not work directly
        // on the collection retained by the store.
        all: () => {
            result: Array(...items)
            for(article in content.all()) {
                result = Arrays.append(result, article)
            }
            result
        }

        find: (slug) => {
            result: null
            for(item in items) {
                if(item.slug == slug) {
                    result = item
                }
            }
            if(result === null) {
                result = content.find(slug)
            }
            result
        }

        // Collect distinct tags in first-seen order across articles.
        tags: () => {
            names: []
            for(item in store.all()) {
                for(tag in item.tagList) {
                    present: false
                    for(name in names) {
                        if(name == tag) {
                            present = true
                        }
                    }
                    if(!present) {
                        names = Arrays.append(names, tag)
                    }
                }
            }
            names
        }

        // Trusted ID-bearing content fixture mutations do not authorize
        // clients; the protected HTTP routes must remain 401.
        // The caller provides collision-free slugs and explicit times.
        createOwnedArticleFixture: (authorId, slug, title, description, body, tags, time) => {
            outcome: null
            if(store.find(slug) !== null) {
                outcome = Content.rejected("slug", "has already been taken")
            } else {
                outcome = content.createArticleFixture(
                    authorId, slug, title, description, body, tags, time
                )
            }
            outcome
        }

        updateOwnedArticleFixture: (actorId, slug, title, description, body, tags, time) => {
            content.updateArticleFixture(
                actorId, slug, title, description, body, tags, time
            )
        }

        deleteOwnedArticleFixture: (actorId, slug) => {
            outcome: content.deleteArticleFixture(actorId, slug)
            if(outcome.ok) {
                // Remove both stable-ID and legacy edges when content is gone.
                // The deleted article's counter is removed with the article.
                favoritesById.removeArticleFixture(slug)
                favorites = Arrays.filter(favorites, (entry) => {
                    entry.slug != slug
                })
                comments = Arrays.filter(comments, (entry) => {
                    entry.slug != slug
                })
            }
            outcome
        }

        createOwnedCommentFixture: (actorId, slug, body, time) => {
            content.createCommentFixture(actorId, slug, body, time)
        }

        deleteOwnedCommentFixture: (actorId, slug, id) => {
            content.deleteCommentFixture(actorId, slug, id)
        }

        // Fixture insertion only. Authenticated mutations arrive later.
        addFixture: (article) => {
            author: identities.findUsername(article.author.username)
            if(author !== null) {
                articleAuthors = Arrays.append(articleAuthors, {
                    article: article
                    authorId: author.id
                })
            }
            items = Arrays.append(items, article)
            article
        }
    }

    store
}
