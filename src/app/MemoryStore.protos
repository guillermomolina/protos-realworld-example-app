//! Actor-local domain-state composition boundary for the learning application.
//!
//! State is captured by closures created inside build(). Each store
//! instance owns its own article, profile, comment and favorite collections.
//! Auth owns security authority. Durable persistence is optional and explicit:
//!
//!   create()                 in-memory store; mutations apply in place
//!                            (unit tests, anonymous fixtures).
//!   restore(domain)          validated reconstruction of the complete
//!                            persistent domain, without a committer.
//!   durable(domain, commit)  the committed state of the persistent service.
//!                            Every application mutation is staged on an
//!                            independent candidate (restore(exportDomain())),
//!                            validated, journaled by `commit` (DurableStore)
//!                            and only then published by swapping repository
//!                            references in one non-suspending step. Direct
//!                            fixture mutation of a durable store is refused.
//!
//! The persistent domain is exactly: identities + credentials (AuthStore
//! table) + managed content + follow edges + favorite edges + both counters.
//! Legacy fixture-only collections (items/profiles/comments/favorites below)
//! are never exported, and a durable store never admits them.
//! An isolated identity repository holds only non-secret account metadata.
//! A separate follow graph and article-author bindings use stable IDs.
//!
//! Fixture insertion methods support examples and tests. They are not
//! credential admission or HTTP authentication.
//!
//! This module is the application's store facade: Api calls these operations,
//! which delegate to the smaller identity, content, follow and favorite stores.
//! All of them live in the same RootActor. The closures share references only
//! inside that Actor; Workers never receive this facade or its nested stores.
//!
//! Methods ending in Fixture predate HTTP authentication. They are trusted
//! setup/domain operations, not security checks. Application-facing wrappers
//! reuse them with IDs obtained from Auth. Tests can still seed data directly.
//! "Managed" content is owned by ContentStore; legacy arrays retain older test
//! fixtures. Both are readable without maintaining a second social graph.

Arrays: import("std:collections/array")
Identities: import("./IdentityStore.protos")
Follows: import("./FollowStore.protos")
ArticleQuery: import("./ArticleQuery.protos")
Content: import("./ContentStore.protos")
Favorites: import("./FavoriteStore.protos")
Credentials: import("./AuthStore.protos")
Slug: import("./Slug.protos")
ISO8601: import("std:datetime/iso8601")

/// Create an independent in-memory store.
create: () => { build(null, null) }

identityRecords: (domain) => {
    Arrays.map(domain.accounts, (account) => {
        {
            id: account.id
            username: account.username
            email: account.email
            bio: account.bio
            image: account.image
        }
    })
}

credentialRecords: (domain) => {
    Arrays.map(domain.accounts, (account) => {
        {
            id: account.id
            subject: account.subject
            verifier: account.verifier
            generation: account.generation
        }
    })
}

/// Cross-repository invariants that no single repository can check alone.
/// Repository restore operations check their own uniqueness/references.
crossChecks: (domain) => {
    // Every timestamp must be a valid ISO8601 instant (parse signals otherwise).
    for(article in domain.articles) {
        ISO8601.parseInstant(article.createdAt)
        ISO8601.parseInstant(article.updatedAt)
        // A stored counter must equal the number of favorite edges.
        count: 0
        for(edge in domain.favorites) {
            if(edge.slug == article.slug) { count = count + 1 }
        }
        if(count != article.favoritesCount) { Error().signal() }
    }
    for(comment in domain.comments) {
        ISO8601.parseInstant(comment.createdAt)
        ISO8601.parseInstant(comment.updatedAt)
    }
    true
}

/// Validate and reconstruct a complete persistent domain. Signals on any
/// violation; never returns a partially restored store.
restore: (domain) => {
    crossChecks(domain)
    build(domain, null)
}

/// Committed state of the durable service. commit is DurableStore's
/// transaction coordinator; see transact below.
durable: (domain, committer) => {
    if(committer === null) { Error().signal() }
    crossChecks(domain)
    build(domain, committer)
}

/// Complete invariant validator: true, or an Error. Builds a throwaway store.
validateDomain: (domain) => {
    restore(domain)
    true
}

/// Private constructor. domain === null means an empty store.
build: (domain, committer) => {
    items: []
    // These first collections are legacy fixture data. The repository objects
    // below retain the records and stable-ID relationships used by HTTP writes.
    profiles: []
    comments: []
    favorites: []
    identities: null
    credentialRepo: null
    follows: null
    content: null
    if(domain === null) {
        identities = Identities.create()
        credentialRepo = Credentials.table([])
        follows = Follows.create(identities)
        content = Content.create(identities)
    } else {
        identities = Identities.restore(identityRecords(domain), domain.nextIdentityId)
        credentialRepo = Credentials.table(credentialRecords(domain))
        follows = Follows.restore(identities, domain.follows)
        content = Content.restore(identities, domain.articles, domain.comments,
            domain.nextCommentId)
    }
    // Fixture article objects are linked to their author IDs when
    // identities exist. Links survive later username changes.
    articleAuthors: []

    articleExists: (slug) => {
        found: content.has(slug)
        if(!found) {
            for(item in items) {
                if(item.slug == slug) {
                    found = true
                }
            }
        }
        found
    }

    favoritesById: null
    if(domain === null) {
        favoritesById = Favorites.create(identities, articleExists)
    } else {
        favoritesById = Favorites.restore(identities, articleExists, domain.favorites)
    }

    // A durable store refuses direct fixture mutation: the only write path is
    // transact, so no entry point can bypass a pending journal commit.
    guardDirect: () => {
        if(committer !== null) { Error().signal() }
        true
    }

    // Read-only credential view for the durable committed state.
    readOnlyCredentials: () => {
        current: credentialRepo
        {
            byId: (id) => { current.byId(id) }
            bySubject: (subject) => { current.bySubject(subject) }
            append: (record) => { Error().signal() }
            replaceVerifier: (id, verifier) => { Error().signal() }
            exportState: () => { current.exportState() }
        }
    }

    // stage(candidate) returns {result, changed}. In-memory stores apply the
    // stage to themselves; durable stores delegate to the committer.
    transactWith: (operation, stage) => {
        answer: null
        if(committer === null) {
            answer = stage(store).result
        } else {
            answer = committer.transact(store, operation, stage)
        }
        answer
    }
    okChanged: (result) => { result.ok && result.changed }
    okOnly: (result) => { result.ok }
    mutate: (operation, changed, apply) => {
        transactWith(operation, (candidate) => {
            value: apply(candidate)
            {
                result: value
                changed: changed(value)
            }
        })
    }

    // Only a new/deleted favorite edge changes the stored counter.
    // For managed content, copies returned by ContentStore are never mutated.
    changeFavoriteCount: (slug, delta) => {
        if(content.has(slug)) {
            if(delta > 0) {
                content.incrementFavoriteFixture(slug)
            } else {
                content.decrementFavoriteFixture(slug)
            }
        } else {
            for(article in items) {
                if(article.slug == slug) {
                    article.favoritesCount = article.favoritesCount + delta
                }
            }
        }
        true
    }

    // Convert a previously unknown username's favorite fixtures to stable
    // identity IDs without incrementing the counts a second time.
    migrateLegacyFavorites: (actorId, username) => {
        remaining: []
        for(entry in favorites) {
            if(entry.username == username) {
                migrated: favoritesById.favoriteFixture(actorId, entry.slug)
                if(migrated.ok) {
                    if(!migrated.changed) {
                        // Both representations counted the same user/article.
                        changeFavoriteCount(entry.slug, -1)
                    }
                } else {
                    remaining = Arrays.append(remaining, entry)
                }
            } else {
                remaining = Arrays.append(remaining, entry)
            }
        }
        favorites = remaining
        true
    }

    store: {
        // ---- durable-state boundary (RootActor transaction coordinator only)

        /// True only for the committed state of the persistent service.
        isDurable: () => { committer !== null }

        /// The private credential table used by AuthStore. A durable committed
        /// store exposes a read-only view: writes must go through transact.
        credentialTable: () => {
            view: credentialRepo
            if(committer !== null) { view = readOnlyCredentials() }
            view
        }

        /// One logical transaction. stage(candidate) -> {result, changed}.
        transact: (operation, stage) => { transactWith(operation, stage) }

        /// Complete persistent domain as fresh, independently owned records.
        /// Signals if an identity lacks its credential (never exports a subset).
        exportDomain: () => {
            identityState: identities.exportState()
            credentialState: credentialRepo.exportState()
            contentState: content.exportState()
            accounts: []
            for(record in identityState.records) {
                credential: null
                for(entry in credentialState) {
                    if(entry.id == record.id) { credential = entry }
                }
                if(credential === null) { Error().signal() }
                accounts = Arrays.append(accounts, {
                    id: record.id
                    username: record.username
                    email: record.email
                    bio: record.bio
                    image: record.image
                    subject: credential.subject
                    verifier: credential.verifier
                    generation: credential.generation
                })
            }
            if(credentialState.size() != accounts.size()) { Error().signal() }
            {
                nextIdentityId: identityState.nextId
                nextCommentId: contentState.nextCommentId
                accounts: accounts
                articles: contentState.articles
                comments: contentState.comments
                follows: follows.exportState()
                favorites: favoritesById.exportState()
            }
        }

        /// A fresh, validated, completely independent candidate. Mutating it
        /// can never change this store.
        stageCandidate: () => { restore(store.exportDomain()) }

        /// The candidate's live repositories, for publication only.
        repositories: () => {
            {
                identities: identities
                credentialTable: credentialRepo
                follows: follows
                content: content
                favoritesById: favoritesById
            }
        }

        /// Publish an already validated and journaled candidate. Contains no
        /// suspension point, so readers observe either all or none of it.
        publish: (candidate) => {
            if(committer === null) { Error().signal() }
            parts: candidate.repositories()
            // Rebuild the favorite graph over THIS store's articleExists so no
            // published repository keeps a Closure from the candidate's scope.
            // All other repositories only reference each other (by object).
            nextFavorites: Favorites.restore(parts.identities,
                (slug) => { parts.content.has(slug) },
                parts.favoritesById.exportState())
            identities = parts.identities
            credentialRepo = parts.credentialTable
            follows = parts.follows
            content = parts.content
            favoritesById = nextFavorites
            true
        }

        // ---- application operations

        articleOwnerId: (slug) => { content.articleOwnerId(slug) }
        commentOwnerId: (slug, id) => { content.commentOwnerId(slug, id) }
        // RootActor application operations. HTTP callers never supply these IDs.
        identityByUsername: (username) => { identities.findUsername(username) }
        // admit/replace run on the store AuthStore was created over: the
        // store itself in memory mode, or a staged candidate when durable.
        admitIdentity: (username, email) => {
            store.addIdentityFixture(username, email, null, null)
        }
        replaceIdentity: (id, username, email, bio, image) => {
            store.updateIdentityFixture(id, username, email, bio, image)
        }
        // Each application mutation is one logical transaction. Rejections and
        // idempotent repeats (changed=false) are never journaled.
        follow: (actorId, targetId) => {
            mutate("follow", okChanged, (s) => { s.followIdentityFixture(actorId, targetId) })
        }
        unfollow: (actorId, targetId) => {
            mutate("unfollow", okChanged, (s) => { s.unfollowIdentityFixture(actorId, targetId) })
        }
        createArticle: (id, slug, title, description, body, tags, time) => {
            mutate("createArticle", okOnly, (s) => {
                s.createOwnedArticleFixture(id, slug, title, description, body, tags, time)
            })
        }
        /// Allocate the slug against the same state that receives the article,
        /// so concurrent creations cannot allocate the same slug.
        createArticleWithTitle: (id, title, description, body, tags, time) => {
            mutate("createArticle", okOnly, (s) => {
                s.createOwnedArticleFixture(id, Slug.allocate(s, title), title,
                    description, body, tags, time)
            })
        }
        updateArticle: (id, slug, title, description, body, tags, time) => {
            mutate("updateArticle", okOnly, (s) => {
                s.updateOwnedArticleFixture(id, slug, title, description, body, tags, time)
            })
        }
        deleteArticle: (id, slug) => {
            mutate("deleteArticle", okOnly, (s) => { s.deleteOwnedArticleFixture(id, slug) })
        }
        createComment: (id, slug, body, time) => {
            mutate("createComment", okOnly, (s) => {
                s.createOwnedCommentFixture(id, slug, body, time)
            })
        }
        deleteComment: (id, slug, commentId) => {
            mutate("deleteComment", okOnly, (s) => {
                s.deleteOwnedCommentFixture(id, slug, commentId)
            })
        }
        favorite: (id, slug) => {
            mutate("favorite", okChanged, (s) => { s.favoriteIdentityFixture(id, slug) })
        }
        unfavorite: (id, slug) => {
            mutate("unfavorite", okChanged, (s) => { s.unfavoriteIdentityFixture(id, slug) })
        }

        // A public profile may be registered explicitly, appear as
        // an article author, or appear only as a comment author.
        findProfile: (username) => {
            // Real identity metadata takes precedence over legacy
            // author/profile fixtures when the usernames coincide.
            found: identities.profileFor(username)

            if(found === null) {
                for(profile in profiles) {
                    if(profile.username == username) {
                        found = profile
                    }
                }
            }

            if(found === null) {
                for(article in items) {
                    if(article.author.username == username) {
                        found = article.author
                    }
                }
            }

            if(found === null) {
                for(entry in comments) {
                    if(entry.comment.author.username == username) {
                        found = entry.comment.author
                    }
                }
            }

            found
        }

        // Credential-free identity metadata. HTTP admission goes through
        // AuthStore; trusted fixtures can also insert identities directly.
        identityById: (id) => {
            identities.findId(id)
        }

        identityByEmail: (email) => {
            identities.findEmail(email)
        }

        addIdentityFixture: (username, email, bio, image) => {
            guardDirect()
            result: identities.addFixture(username, email, bio, image)
            if(result.ok) {
                migrateLegacyFavorites(result.value.id, username)
            }
            result
        }

        updateIdentityFixture: (id, username, email, bio, image) => {
            guardDirect()
            previous: identities.findId(id)
            result: identities.updateFixture(id, username, email, bio, image)
            if(result.ok) {
                migrateLegacyFavorites(id, previous.username)
                if(username != previous.username) {
                    migrateLegacyFavorites(id, username)
                }
            }
            result
        }

        // Fixture-only social operations: they do not authenticate a caller.
        followIdentityFixture: (followerId, followedId) => {
            guardDirect()
            follows.followFixture(followerId, followedId)
        }

        unfollowIdentityFixture: (followerId, followedId) => {
            guardDirect()
            follows.unfollowFixture(followerId, followedId)
        }

        isFollowingIdentity: (followerId, followedId) => {
            follows.isFollowing(followerId, followedId)
        }

        followingIdentityIdsFor: (followerId) => {
            follows.followingIdsFor(followerId)
        }

        followerIdentityIdsFor: (followedId) => {
            follows.followerIdsFor(followedId)
        }

        /// Select followed authors' articles, newest first, then paginate.
        /// The viewer identity must exist. Options come from ArticleQuery.read.
        /// No caller may obtain this by sending an unauthenticated HTTP request.
        feedForIdentity: (viewerId, options) => {
            result: {
                ok: false
                page: []
                total: 0
                field: "user"
                message: "not found"
            }

            if(identities.findId(viewerId) !== null) {
                followedIds: follows.followingIdsFor(viewerId)
                selectedArticles: []
                for(article in items) {
                    authorId: null

                    // Prefer the stable association captured on insertion.
                    for(binding in articleAuthors) {
                        if(binding.article === article) {
                            authorId = binding.authorId
                        }
                    }

                    // Legacy fixtures may predate their author identity.
                    if(authorId === null) {
                        author: identities.findUsername(article.author.username)
                        if(author !== null) {
                            authorId = author.id
                        }
                    }

                    if((authorId !== null) &&
                       Arrays.contains(followedIds, authorId)) {
                        selectedArticles = Arrays.append(selectedArticles, article)
                    }
                }

                // Managed article authors are already linked by stable ID.
                for(entry in content.entries()) {
                    if(Arrays.contains(followedIds, entry.authorId)) {
                        selectedArticles = Arrays.append(
                            selectedArticles, entry.article
                        )
                    }
                }

                selected: ArticleQuery.select(selectedArticles, options, [])
                result = {
                    ok: true
                    page: selected.page
                    total: selected.total
                    field: null
                    message: null
                }
            }

            result
        }

        addProfileFixture: (profile) => {
            guardDirect()
            profiles = Arrays.append(profiles, profile)
            profile
        }

        commentsFor: (slug) => {
            result: []

            for(entry in comments) {
                if(entry.slug == slug) {
                    result = Arrays.append(result, entry.comment)
                }
            }
            for(comment in content.commentsFor(slug)) {
                result = Arrays.append(result, comment)
            }
            result
        }

        addCommentFixture: (slug, value) => {
            guardDirect()
            comments = Arrays.append(
                comments,
                {
                    slug: slug
                    comment: value
                }
            )
            value
        }

        // Stable-ID favorite operations are internal trusted fixtures.
        // These IDs cannot be supplied by an unauthenticated HTTP request.
        favoriteIdentityFixture: (actorId, slug) => {
            guardDirect()
            result: favoritesById.favoriteFixture(actorId, slug)
            if(result.ok && result.changed) {
                changeFavoriteCount(slug, 1)
            }
            result
        }

        unfavoriteIdentityFixture: (actorId, slug) => {
            guardDirect()
            result: favoritesById.unfavoriteFixture(actorId, slug)
            if(result.ok && result.changed) {
                changeFavoriteCount(slug, -1)
            }
            result
        }

        isFavoritedByIdentity: (actorId, slug) => {
            favoritesById.isFavorited(actorId, slug)
        }

        favoriteSlugsForIdentity: (actorId) => {
            favoritesById.slugsFor(actorId)
        }

        // Public ?favorited=username resolves the current identity, so
        // changing a username does not break its favorite edges.
        favoriteSlugsFor: (username) => {
            slugs: []
            actor: identities.findUsername(username)
            if(actor !== null) {
                slugs = favoritesById.slugsFor(actor.id)
            }
            // Keep pre-identity legacy fixtures working, without duplicates.
            for(entry in favorites) {
                if((entry.username == username) &&
                   !Arrays.contains(slugs, entry.slug)) {
                    slugs = Arrays.append(slugs, entry.slug)
                }
            }
            slugs
        }

        // Legacy fixture API remains available. Known identities are routed
        // through the stable-ID graph; unknown usernames remain string edges.
        addFavoriteFixture: (username, slug) => {
            guardDirect()
            article: store.find(slug)
            if(article === null) {
                Error().signal()
            }

            actor: identities.findUsername(username)
            if(actor !== null) {
                store.favoriteIdentityFixture(actor.id, slug)
            } else {
                present: Arrays.contains(store.favoriteSlugsFor(username), slug)
                if(!present) {
                    favorites = Arrays.append(favorites, {
                        username: username
                        slug: slug
                    })
                    changeFavoriteCount(slug, 1)
                }
            }
            store.find(slug)
        }

        // Return a new Array so query operations do not work directly
        // on the collection retained by the store.
        all: () => {
            result: Array(...items)
            for(article in content.all()) {
                result = Arrays.append(result, article)
            }
            result
        }

        find: (slug) => {
            result: null
            for(item in items) {
                if(item.slug == slug) {
                    result = item
                }
            }
            if(result === null) {
                result = content.find(slug)
            }
            result
        }

        // Collect distinct tags in first-seen order across articles.
        tags: () => {
            names: []
            for(item in store.all()) {
                for(tag in item.tagList) {
                    present: false
                    for(name in names) {
                        if(name == tag) {
                            present = true
                        }
                    }
                    if(!present) {
                        names = Arrays.append(names, tag)
                    }
                }
            }
            names
        }

        // Trusted ID-bearing content fixture mutations do not authorize
        // clients; Auth supplies the actor ID to application-facing operations.
        // The caller provides collision-free slugs and explicit times.
        createOwnedArticleFixture: (authorId, slug, title, description, body, tags, time) => {
            guardDirect()
            outcome: null
            if(store.find(slug) !== null) {
                outcome = Content.rejected("slug", "has already been taken")
            } else {
                outcome = content.createArticleFixture(
                    authorId, slug, title, description, body, tags, time
                )
            }
            outcome
        }

        updateOwnedArticleFixture: (actorId, slug, title, description, body, tags, time) => {
            guardDirect()
            content.updateArticleFixture(
                actorId, slug, title, description, body, tags, time
            )
        }

        deleteOwnedArticleFixture: (actorId, slug) => {
            guardDirect()
            outcome: content.deleteArticleFixture(actorId, slug)
            if(outcome.ok) {
                // Remove both stable-ID and legacy edges when content is gone.
                // The deleted article's counter is removed with the article.
                favoritesById.removeArticleFixture(slug)
                favorites = Arrays.filter(favorites, (entry) => {
                    entry.slug != slug
                })
                comments = Arrays.filter(comments, (entry) => {
                    entry.slug != slug
                })
            }
            outcome
        }

        createOwnedCommentFixture: (actorId, slug, body, time) => {
            guardDirect()
            content.createCommentFixture(actorId, slug, body, time)
        }

        deleteOwnedCommentFixture: (actorId, slug, id) => {
            guardDirect()
            content.deleteCommentFixture(actorId, slug, id)
        }

        // Fixture insertion only. HTTP uses the application-facing operations.
        addFixture: (article) => {
            guardDirect()
            author: identities.findUsername(article.author.username)
            if(author !== null) {
                articleAuthors = Arrays.append(articleAuthors, {
                    article: article
                    authorId: author.id
                })
            }
            items = Arrays.append(items, article)
            article
        }
    }

    store
}
