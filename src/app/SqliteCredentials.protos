//! Persistent credential records for AuthStore, stored in the credentials table.
//!
//! A record is {id, subject, verifier, generation}: id is the stable user ID,
//! subject the immutable public JWT subject, verifier the opaque Argon2id record
//! produced by std:crypto/password, and generation the revocation counter.
//! No plaintext password and no JWT signing key is ever stored here.
//!
//! This repository has no security logic of its own. AuthStore keeps password
//! policy, hashing, verification and revocation rules; this module only reads
//! and writes rows. Every lookup returns a fresh copied object, so callers must
//! compare record contents (same) rather than object identity.
//!
//! Inserts and replacements must run inside atomically(...), the same SQLite
//! transaction in which SqliteStore admits or replaces the identity metadata.
create: (database) => {
    recordFrom: (rows) => {
        found: null
        if(rows.size() > 0) {
            row: rows[0]
            found = {
                id: row[0]
                subject: row[1]
                verifier: row[2]
                generation: row[3]
            }
        }
        found
    }

    requireTransaction: () => {
        if(!database.inTransaction()) { Error().signal() }
        true
    }

    repository: {
        byId: (id) => {
            recordFrom(database.rows("SELECT user_id, subject, verifier, generation FROM credentials WHERE user_id = ?1", [id]))
        }

        bySubject: (subject) => {
            recordFrom(database.rows("SELECT user_id, subject, verifier, generation FROM credentials WHERE subject = ?1", [subject]))
        }

        /// Store the initial credential row for a just-admitted identity.
        insert: (id, subject, verifier, generation) => {
            requireTransaction()
            if(database.execute("INSERT INTO credentials (user_id, subject, verifier, generation) VALUES (?1, ?2, ?3, ?4)",
                [id, subject, verifier, generation]) != 1) {
                Error().signal()
            }
            true
        }

        /// Install a new verifier and advance generation exactly once, but only
        /// if the row still has the generation the caller read. A mismatch is
        /// an operational inconsistency that rolls the transaction back.
        replace: (id, verifier, expectedGeneration) => {
            requireTransaction()
            if(database.execute("UPDATE credentials SET verifier = ?2, generation = generation + 1 WHERE user_id = ?1 AND generation = ?3",
                [id, verifier, expectedGeneration]) != 1) {
                Error().signal()
            }
            true
        }

        /// One SQLite transaction shared by identity and credential changes.
        atomically: (operation) => { database.transaction(operation) }

        /// Records read at different times describe the same credential state.
        same: (left, right) => {
            (left !== null) && (right !== null) && (left.id == right.id) &&
                (left.subject == right.subject) && (left.verifier == right.verifier) &&
                (left.generation == right.generation)
        }
    }

    repository
}
