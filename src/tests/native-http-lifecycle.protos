//! Self-contained native Actor HTTP concurrency and shutdown integration test.
//!
//! Run with --allow-network --service=service: the RootActor creates an
//! ephemeral loopback listener, delegates two acceptors, acts as the test
//! client and validates the actual RealWorld Worker module.
//! No production HTTP test-only route or external Python/Java client is used.
//!
//! Gates below coordinate observable events rather than guessing timings with
//! sleeps. This makes overlap, admission cutover and cleanup assertions about
//! actual Actor progress. A successful HTTP response alone cannot prove drain
//! or cancellation correctness, which is why this suite is separate.

Assertions: import("std:test/assertions")
Client: import("std:http/client").Client
IpAddress: import("std:network/ip_addresses").IpAddress
IpEndpoint: import("std:network/ip_endpoints").IpEndpoint
HttpWorkers: import("../app/HttpWorkers.protos")
Store: import("../app/MemoryStore.protos")
Api: import("../app/Api.protos")

loopback: IpAddress(4, 2130706433)

// A cancellation-backed one-shot notification, following the same approach
// used by the Standard Library HTTP host's Worker readiness gate. This avoids
// time-based sleeps and cannot busy-spin an Actor that must receive messages.
makeGate: () => {
    blocker: (() => { Actor.current().termination().value() }).future()
    opened: (() => {
        Error.handle(
            () => { blocker.value() },
            (error) => { error }
        )
        true
    }).future()
    {
        wait: () => { opened.value() }
        open: () => { blocker.cancel() }
    }
}

readBody: (response) => {
    bytes: Encoding.Latin1.encode("")
    chunk: response.body.read(4096).value()
    while(chunk !== null) {
        for(octet in chunk) {
            bytes.add(octet)
        }
        chunk = response.body.read(4096).value()
    }
    Encoding.UTF8.decode(bytes)
}

request: {
    method: "GET"
    target: Encoding.Latin1.encode("/api/tags")
    headers: [["Host", Encoding.Latin1.encode("127.0.0.1")]]
    body: null
}

// Test one complete HTTP exchange while another Worker is occupied by an
// accepted, deliberately incomplete HTTP request head.
checkUnblockedRequest: (network, endpoint) => {
    connection: network.connectTcp(endpoint).value()
    Client.exchangeOne.owning(connection, request, (response) => {
        Assertions.require(response.status == 200)
        Assertions.require(readBody(response) == "{\"tags\":[]}")
        true
    }, null).value()
}

// Verify that the Worker transfers the decoded body and original field
// ordering/casing as a snapshot through the real Actor request/reply path.
checkTransferred: (network, endpoint, target, body) => {
    connection: network.connectTcp(endpoint).value()
    request: {
        method: "POST"
        target: Encoding.Latin1.encode(target)
        headers: [
            ["Host", Encoding.Latin1.encode("127.0.0.1")],
            ["Authorization", Encoding.Latin1.encode("Token not-real")],
            ["X-Probe", Encoding.Latin1.encode("first")],
            ["x-probe", Encoding.Latin1.encode("second")]
        ]
        body: body
    }
    Client.exchangeOne.owning(connection, request, (response) => {
        Assertions.require(response.status == 204)
        true
    }, null).value()
}

// The raw request probe also covers chunked decoding and early body limits;
// the standard Client intentionally writes Content-Length, not chunked.
checkRawStatus: (network, endpoint, wire, expectedStatus) => {
    connection: network.connectTcp(endpoint).value()
    connection.write(Encoding.Latin1.encode(wire)).value()
    bytes: Encoding.Latin1.encode("")
    chunk: connection.read(4096).value()
    while(chunk !== null) {
        for(octet in chunk) {
            bytes.add(octet)
        }
        chunk = connection.read(4096).value()
    }
    prefix: Encoding.Latin1.encode("HTTP/1.1 " + expectedStatus)
    Assertions.require(bytes.size() >= prefix.size())
    for(index, 0, prefix.size()) {
        Assertions.require(bytes[index] == prefix[index])
    }
    connection.close().value()
}

// Read the raw held HTTP response to EOF. Assert its exact status prefix,
// without depending on packet/read chunk boundaries.
finishHeldRequest: (connection) => {
    connection.write(Encoding.Latin1.encode("\r\n")).value()
    bytes: Encoding.Latin1.encode("")
    chunk: connection.read(4096).value()
    while(chunk !== null) {
        for(octet in chunk) {
            bytes.add(octet)
        }
        chunk = connection.read(4096).value()
    }
    expected: Encoding.Latin1.encode("HTTP/1.1 200")
    Assertions.require(bytes.size() >= expected.size())
    for(index, 0, expected.size()) {
        Assertions.require(bytes[index] == expected[index])
    }
    connection.close().value()
}

// Listener is closed after shutdown, so no new TCP connection can be acquired.
checkClosed: (network, endpoint) => {
    rejected: false
    unexpected: null
    Error.handle(
        () => { unexpected = network.connectTcp(endpoint).value() },
        (error) => {
            rejected = true
            error
        }
    )
    if(unexpected !== null) {
        unexpected.close().value()
    }
    Assertions.require(rejected)
}

service: (network, writer) => {
    writer.writeLine("REALWORLD_LIFECYCLE_BOOT=BEGIN").value()
    store: Store.create()
    handler: Api.make(store)
    application: Actor.group(Actor.current())
    listener: null
    host: null
    acceptedWorkers: []
    acceptedGate: null
    failures: 0

    behavior: {
        connectionAccepted: (workerId) => {
            acceptedWorkers = Array(...acceptedWorkers, workerId)
            if(acceptedWorkers.size() == 1) {
                acceptedGate.open()
            }
            null
        }
        connectionFailed: (workerId) => {
            failures = failures + 1
            null
        }
        handle: (request) => {
            // Fixture-only probes stay in the RootActor.
            target: Encoding.Latin1.decode(request.target)

            if(target == "/__worker_probe__") {
                Assertions.require(request.method == "POST")
                Assertions.require(request.version == "1.1")
                Assertions.require(
                    Encoding.UTF8.decode(request.body) ==
                        "{\"article\":{\"body\":\"mañana\"}}"
                )
                probes: []
                authorization: false
                for(field in request.headers) {
                    if(field[0] == "X-Probe" || field[0] == "x-probe") {
                        probes = Array(...probes, field)
                    }
                    if(field[0] == "Authorization") {
                        authorization =
                            Encoding.Latin1.decode(field[1]) == "Token not-real"
                    }
                }
                Assertions.require(authorization)
                Assertions.require(probes.size() == 2)
                Assertions.require(probes[0][0] == "X-Probe")
                Assertions.require(probes[1][0] == "x-probe")
                Assertions.require(Encoding.Latin1.decode(probes[0][1]) == "first")
                Assertions.require(Encoding.Latin1.decode(probes[1][1]) == "second")
                {
                    status: 204
                    headers: []
                    body: null
                }
            } else {
                if(target == "/__worker_probe_empty__") {
                    Assertions.require(request.method == "POST")
                    Assertions.require(request.version == "1.1")
                    Assertions.require(request.body.size() == 0)
                    {
                        status: 204
                        headers: []
                        body: null
                    }
                } else {
                    if(target == "/__worker_probe_chunked__") {
                        Assertions.require(request.method == "POST")
                        Assertions.require(request.version == "1.1")
                        Assertions.require(
                            Encoding.Latin1.decode(request.body) == "Wikipedia"
                        )
                        {
                            status: 204
                            headers: []
                            body: null
                        }
                    } else {
                        handler(request)
                    }
                }
            }
        }
        run: () => {
            acceptedGate = makeGate()
            listener = network.listenTcp(
                ipVersion: 4,
                address: loopback,
                port: null
            ).value()
            endpoint: IpEndpoint(loopback, listener.localPort())
            host = HttpWorkers.start(listener, application, 2)

            // Hold one Worker on a partial HTTP head, and wait for the
            // corresponding Actor message before opening the second client.
            held: network.connectTcp(endpoint).value()
            held.write(Encoding.Latin1.encode(
                "GET /api/tags HTTP/1.1\r\nHost: 127.0.0.1\r\n"
            )).value()
            acceptedGate.wait()
            Assertions.require(acceptedWorkers.size() == 1)
            checkUnblockedRequest(network, endpoint)
            Assertions.require(acceptedWorkers.size() == 2)
            Assertions.require(acceptedWorkers[0] != acceptedWorkers[1])
            Assertions.require(failures == 0)
            writer.writeLine("REALWORLD_CONCURRENT_WORKERS=PASS").value()

            checkTransferred(
                network,
                endpoint,
                "/__worker_probe__",
                Encoding.UTF8.encode("{\"article\":{\"body\":\"mañana\"}}")
            )
            checkTransferred(network, endpoint, "/__worker_probe_empty__", null)
            checkRawStatus(
                network,
                endpoint,
                "POST /__worker_probe_chunked__ HTTP/1.1\r\n" +
                "Host: 127.0.0.1\r\n" +
                "Transfer-Encoding: chunked\r\n\r\n" +
                "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n",
                "204"
            )
            writer.writeLine("REALWORLD_HTTP_ENVELOPE=PASS").value()

            // Reject before invoking the handler: a large declared body is
            // enough to exceed the configured cap without allocating it.
            checkRawStatus(
                network,
                endpoint,
                "POST /api/articles HTTP/1.1\r\n" +
                "Host: 127.0.0.1\r\n" +
                "Content-Length: 1048577\r\n\r\n",
                "413"
            )
            writer.writeLine("REALWORLD_HTTP_LIMIT=PASS").value()

            // Drain starts synchronously, before the first in-flight request
            // head is completed. The previously accepted session must survive.
            closing: host.shutdown("drain")
            finishHeldRequest(held)
            Assertions.require(closing.value() === true)
            checkClosed(network, endpoint)
            writer.writeLine("REALWORLD_HTTP_DRAIN=PASS").value()

            // Abort a separate listener with an admitted but incomplete
            // request, checking that cancellation and owning cleanup finish.
            acceptedWorkers = []
            acceptedGate = makeGate()
            listener = network.listenTcp(
                ipVersion: 4,
                address: loopback,
                port: null
            ).value()
            endpoint = IpEndpoint(loopback, listener.localPort())
            host = HttpWorkers.start(listener, application, 2)
            blocked: network.connectTcp(endpoint).value()
            blocked.write(Encoding.Latin1.encode(
                "GET /api/tags HTTP/1.1\r\nHost: 127.0.0.1\r\n"
            )).value()
            acceptedGate.wait()
            Assertions.require(host.shutdown("abort").value() === true)
            blocked.close().value()
            checkClosed(network, endpoint)
            writer.writeLine("REALWORLD_HTTP_ABORT=PASS").value()

            // All Workers are known terminated; the RootActor can now stop.
            Actor.current().stop()
            null
        }
    }
    Actor.current().send("run")
    writer.writeLine("REALWORLD_LIFECYCLE_BOOT=END").value()
    behavior
}
