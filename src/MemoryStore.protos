// Actor-local, temporary storage for the first HTTP/JSON slice.
// Not a durable database and not an authentication authority.

Arrays: import("std:collections/array")

create: () => {
    items: []
    profiles: []
    comments: []
    favorites: []

    store: {
        findProfile: (username) => {
            found: null

            for(profile in profiles) {
                if(profile.username == username) {
                    found = profile
                }
            }

            if(found === null) {
                for(article in items) {
                    if(article.author.username == username) {
                        found = article.author
                    }
                }
            }

            if(found === null) {
                for(entry in comments) {
                    if(entry.comment.author.username == username) {
                        found = entry.comment.author
                    }
                }
            }

            found
        }

        addProfileFixture: (profile) => {
            profiles = Arrays.append(profiles, profile)
            profile
        }

        commentsFor: (slug) => {
            result: []

            for(entry in comments) {
                if(entry.slug == slug) {
                    result = Arrays.append(result, entry.comment)
                }
            }

            result
        }

        addCommentFixture: (slug, value) => {
            comments = Arrays.append(
                comments,
                {
                    slug: slug
                    comment: value
                }
            )
            value
        }

        // Favorites supplied by test fixtures, not HTTP authentication.
        favoriteSlugsFor: (username) => {
            slugs: []
            for(entry in favorites) {
                if(entry.username == username) {
                    slugs = Arrays.append(slugs, entry.slug)
                }
            }
            slugs
        }

        addFavoriteFixture: (username, slug) => {
            article: store.find(slug)
            if(article === null) {
                Error().signal()
            }

            already: Arrays.contains(store.favoriteSlugsFor(username), slug)
            if(!already) {
                favorites = Arrays.append(
                    favorites,
                    {
                        username: username
                        slug: slug
                    }
                )
                article.favoritesCount = article.favoritesCount + 1
            }

            article
        }

        all: () => {
            Array(...items)
        }

        find: (slug) => {
            result: null
            for(item in items) {
                if(item.slug == slug) {
                    result = item
                }
            }
            result
        }

        tags: () => {
            names: []
            for(item in items) {
                for(tag in item.tagList) {
                    present: false
                    for(name in names) {
                        if(name == tag) {
                            present = true
                        }
                    }
                    if(!present) {
                        names = Arrays.append(names, tag)
                    }
                }
            }
            names
        }

        // Fixture insertion only. Authenticated mutations arrive later.
        addFixture: (article) => {
            items = Arrays.append(items, article)
            article
        }
    }

    store
}
