//! Query parsing, validation and article selection.
//!
//! This module receives query text from the Router. It converts parameters
//! into ordinary Protos values, filters articles and applies pagination.
//! It does not access HTTP connections, storage or network capabilities.

Arrays: import("std:collections/array")

hexValue: (octet) => {
    value: -1
    if((octet >= 48) && (octet <= 57)) {
        value = octet - 48
    }
    if((octet >= 65) && (octet <= 70)) {
        value = octet - 55
    }
    if((octet >= 97) && (octet <= 102)) {
        value = octet - 87
    }
    value
}

/// Decode one URL query component from its UTF-8 bytes.
/// '+' represents a space; '%HH' represents an encoded byte.
/// Invalid percent escapes signal an Error to the caller.
decodeComponent: (source) => {
    output: Encoding.UTF8.encode("")
    index: 0

    while(index < source.size()) {
        octet: source[index]

        if(octet == 37) {
            if(index + 2 >= source.size()) {
                Error().signal()
            }

            high: hexValue(source[index + 1])
            low: hexValue(source[index + 2])

            if((high < 0) || (low < 0)) {
                Error().signal()
            }

            output.add(high * 16 + low)
            index = index + 3
        } else {
            if(octet == 43) {
                output.add(32)
            } else {
                output.add(octet)
            }
            index = index + 1
        }
    }

    Encoding.UTF8.decode(output)
}

/// Parse a query string into a Map.
/// Repeated parameter names use the last supplied value.
/// Empty parameter names are ignored.
parse: (query) => {
    parameters: Map()

    if(query !== null) {
        source: Encoding.UTF8.encode(query)
        nameBytes: Encoding.UTF8.encode("")
        valueBytes: Encoding.UTF8.encode("")
        inValue: false

        finishParameter: () => {
            if(nameBytes.size() > 0) {
                name: decodeComponent(nameBytes)
                value: decodeComponent(valueBytes)
                parameters[name] = value
            }

            nameBytes = Encoding.UTF8.encode("")
            valueBytes = Encoding.UTF8.encode("")
            inValue = false
        }

        for(octet in source) {
            if(octet == 38) {
                finishParameter()
            } else {
                if((octet == 61) && !inValue) {
                    inValue = true
                } else {
                    if(inValue) {
                        valueBytes.add(octet)
                    } else {
                        nameBytes.add(octet)
                    }
                }
            }
        }

        finishParameter()
    }

    parameters
}

nonNegativeInteger: (text, minimum) => {
    digits: Encoding.UTF8.encode(text)

    if(digits.size() == 0) {
        Error().signal()
    }

    result: 0

    for(octet in digits) {
        if((octet < 48) || (octet > 57)) {
            Error().signal()
        }
        result = result * 10 + octet - 48
    }

    if(result < minimum) {
        Error().signal()
    }

    result
}

/// Validate listing options and apply RealWorld defaults.
/// The default limit is 20 and the default offset is 0.
/// Limit must be positive; offset may be zero.
read: (query) => {
    parameters: parse(query)
    limit: 20
    offset: 0

    if(parameters.containsKey("limit")) {
        limit = nonNegativeInteger(parameters["limit"], 1)
    }

    if(parameters.containsKey("offset")) {
        offset = nonNegativeInteger(parameters["offset"], 0)
    }

    {
        parameters: parameters
        limit: limit
        offset: offset
    }
}

// ISO UTC timestamps in the fixtures share a canonical format, so
// lexicographic byte comparison also gives chronological ordering.
// This assumption must be revisited if other timestamp formats are allowed.
laterThan: (left, right) => {
    a: Encoding.UTF8.encode(left)
    b: Encoding.UTF8.encode(right)

    count: a.size()
    if(b.size() < count) {
        count = b.size()
    }

    index: 0
    decided: false
    later: false

    while((index < count) && !decided) {
        if(a[index] != b[index]) {
            later = a[index] > b[index]
            decided = true
        }
        index = index + 1
    }

    if(!decided) {
        later = a.size() > b.size()
    }

    later
}

/// Filter, sort and paginate articles without modifying the input.
/// favoriteSlugs is supplied by the store for the requested username.
/// The total count is calculated before applying limit and offset.
select: (articles, options, favoriteSlugs) => {
    parameters: options.parameters

    filtered: Arrays.filter(articles, (article) => {
        included: true

        if(parameters.containsKey("tag")) {
            included = included &&
                Arrays.contains(article.tagList, parameters["tag"])
        }

        if(parameters.containsKey("author")) {
            included = included &&
                (article.author.username == parameters["author"])
        }

        if(parameters.containsKey("favorited")) {
            included = included &&
                Arrays.contains(favoriteSlugs, article.slug)
        }

        included
    })

    ordered: Arrays.sort(filtered, (left, right) => {
        laterThan(left.createdAt, right.createdAt)
    })

    total: ordered.size()
    start: options.offset

    if(start > total) {
        start = total
    }

    end: start + options.limit

    if(end > total) {
        end = total
    }

    {
        page: Arrays.slice(ordered, start, end)
        total: total
    }
}
